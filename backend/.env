# ─── Server ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── DB Service (owns the Postgres connection) ─────────
DB_SERVICE_URL=http://localhost:8001

# ─── Session ──────────────────────────────────────────
SESSION_SECRET=change_this_to_a_long_random_string_in_production

# ─── CORS ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,https://localhost:5173

# ─── SSL (left empty on purpose: no local certs, falls back to HTTP) ─────────
SSL_KEY_PATH=
SSL_CERT_PATH=

# ─── Face Service ─────────────────────────────────────
FACE_API_URL=http://localhost:8000
FACE_ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000
FACE_DIRS= reference_faces


# ─── Rate Limiting ────────────────────────────────────
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=200
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=60
