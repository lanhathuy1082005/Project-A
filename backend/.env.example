# ─── Server ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────
DB_USER=postgres
DB_HOST=localhost
DB_NAME=project_a
DB_PASSWORD=your_db_password_here
DB_PORT=5432

# ─── Session ──────────────────────────────────────────
SESSION_SECRET=your_long_random_secret_here

# ─── CORS ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,https://localhost:5173

# ─── SSL (leave empty if using HTTP) ─────────────────────
SSL_KEY_PATH=./certs/localhost+2-key.pem
SSL_CERT_PATH=./certs/localhost+2.pem

# ─── Face Service ─────────────────────────────────────
FACE_API_URL=http://localhost:8000
SCAN_MODEL_URL=http://localhost:8000
KIT_SCAN_CONFIDENCE_THRESHOLD=0.8
SINGLE_SCAN_CONFIDENCE_THRESHOLD=0.8
# false: students pick the kit unit from a list (no kit QR stickers yet)
KIT_QR_REQUIRED=false
SCAN_PREVIEW_TIMEOUT_MS=3000
SCAN_OFFICIAL_TIMEOUT_MS=15000
# Time zone used to match the current class in the timetable
LAB_TIMEZONE=Asia/Bangkok

# ─── Rate Limiting ────────────────────────────────────
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=60
# Per-user budget for camera scan frames (the app sends ~1-3 per second)
SCAN_FRAME_RATE_LIMIT_MAX=240
# Tests clone the dev DB schema into this database (dropped and recreated each run)
TEST_DB_NAME=project_a_test
