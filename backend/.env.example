# ─── Server ───────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Database ─────────────────────────────────────────
DB_USER=postgres
DB_HOST=localhost
DB_NAME=project_a
DB_PASSWORD=your_db_password_here
DB_PORT=5432

# ─── Session ──────────────────────────────────────────
SESSION_SECRET=your_long_random_secret_here

# ─── CORS ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,https://localhost:5173

# ─── SSL (leave empty if using HTTP) ─────────────────────
SSL_KEY_PATH=./certs/localhost+2-key.pem
SSL_CERT_PATH=./certs/localhost+2.pem

# ─── Face Service ─────────────────────────────────────
FACE_API_URL=http://localhost:8000

# ─── Rate Limiting ────────────────────────────────────
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=60
